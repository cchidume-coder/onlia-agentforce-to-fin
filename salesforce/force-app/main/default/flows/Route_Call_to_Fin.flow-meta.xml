    </assignments>
    <assignments>
        <name>Transfer_Failed</name>
        <label>Fin unavailable — use human fallback</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>routingNote</assignToReference>
            <operator>Assign</operator>
            <value>
