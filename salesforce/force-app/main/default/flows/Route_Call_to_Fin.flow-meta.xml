    <decisions>
        <name>Caller_Still_Connected</name>
        <label>Caller still connected?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stop_Completed_Call</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Otherwise</defaultConnectorLabel>
        <rules>
            <name>Still_Connected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Refresh_Call.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Refresh_Call.CallDisposition</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Voice_Queue</targetReference>
            </connector>
            <label>Caller remains — human handoff</label>
        </rules>
    </decisions>
    <decisions>
        <name>Queue_Available</name>
        <label>Voice queue available?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Routing_Failed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Otherwise</defaultConnectorLabel>
        <rules>
            <name>Found_Queue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Voice_Queue.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Case_and_Contact_on_Call</targetReference>
            </connector>
            <label>Queue found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Test_Route_to_Fin</name>
        <label>Test Route to Fin</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Say_Hello</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Otherwise</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>routeToFin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_to_Fin</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Route live caller audio to Fin +16594653025, then route a still-connected caller to General Voice. Fin leaves its external leg to request human handoff. No Fin resolution flag or historical transcript transfer is provided by the native action. Caller disconnect stops escalation. Reuse an existing Case and retain VoiceCall Contact. Active flow is not automatically assigned to a phone channel.</description>
    <environments>Default</environments>
    <interviewLabel>Route Call to Fin {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Route Call to Fin</label>
